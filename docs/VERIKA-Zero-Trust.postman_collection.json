    {
      "name": "2. Nilai & Kelas (Service Nilai via Gateway)",
      "item": [
        {
          "name": "2.1 Mahasiswa Membaca Nilai Sendiri (ALLOW)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{MAHASISWA_TOKEN}}" },
              { "key": "X-Device-ID", "value": "DEV-MHS-001" }
            ],
            "url": { "raw": "http://localhost:3000/nilai", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["nilai"] }
          }
        },
        {
          "name": "2.2 Dosen Membaca Nilai Kelas yang Diampu (ALLOW)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{DOSEN_TOKEN}}" },
              { "key": "X-Device-ID", "value": "DEV-DSN-001" }
