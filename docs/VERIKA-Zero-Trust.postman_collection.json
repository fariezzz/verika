            },
            "url": { "raw": "http://localhost:3000/nilai/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["nilai", "1"] }
          }
        },
        {
          "name": "2.4 Dosen Ditolak Mengubah Kelas Dosen Lain (DENY 403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{DOSEN_TOKEN}}" },
              { "key": "X-Device-ID", "value": "DEV-DSN-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nilai_angka\": 95.0\n}"
            },
            "url": { "raw": "http://localhost:3000/nilai/7", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["nilai", "7"] }
          }
        },
        {
          "name": "2.5 Finalisasi Kelas oleh Dosen Pengampu (ALLOW)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{DOSEN_TOKEN}}" },
