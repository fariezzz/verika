# Konfigurasi Database (MySQL / MariaDB Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zero_trust_db

# Port Layanan
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002
FRONTEND_PORT=5173

# URL Internal & Eksternal
GATEWAY_URL=http://localhost:3000
NILAI_URL=http://localhost:3001
TRANSKRIP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# Kunci Rahasia JWT (Zero Trust)
# Access token: masa berlaku 10 menit
# Refresh token: masa berlaku 1 hari
JWT_ACCESS_SECRET=zero_trust_access_super_secret_key_2026_unsil
JWT_REFRESH_SECRET=zero_trust_refresh_super_secret_key_2026_unsil
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=1d

# Kredensial Service Nilai (Inter-service authentication)
SERVICE_NILAI_CLIENT_ID=service-nilai-unsil
SERVICE_NILAI_CLIENT_SECRET=svc_nilai_secret_key_9876543210
JWT_SERVICE_EXPIRES_IN=5m

# Gateway Secret (Defense-in-depth: disisipkan oleh Gateway ke Service)
GATEWAY_SECRET=gw_secret_internal_zero_trust_unsil_2026

# Kebijakan Waktu Akses Perubahan/Finalisasi Nilai (Asia/Jakarta)
APP_TIMEZONE=Asia/Jakarta
GRADE_EDIT_START=07:00
GRADE_EDIT_END=21:00
